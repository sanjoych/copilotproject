<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>$(MSBuildProjectDirectory)\docker-compose.yml</DockerComposeProjectPath>
  </PropertyGroup>

  <!-- Exclude test project sources placed under the unittest folder from the main project
       so they aren't compiled into this assembly (prevents duplicate assembly attributes
       and missing test-framework references). -->
  <ItemGroup>
    <Compile Remove="unittest\**\*.cs" />
    <None Remove="unittest\**\*" />
    <EmbeddedResource Remove="unittest\**\*" />
  </ItemGroup>

  <!-- Docker build targets -->
  <Target Name="CheckDockerCompose" BeforeTargets="BuildDockerImage">
    <Exec Command="powershell -Command &quot;&amp; {if (!(Get-Command docker-compose -ErrorAction SilentlyContinue)) { winget install Docker.DockerDesktop }}&quot;" 
          IgnoreExitCode="false"
          StandardOutputImportance="low" />
  </Target>

  <Target Name="BuildDockerImage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'" DependsOnTargets="CheckDockerCompose">
    <Exec Command="docker-compose build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
